{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WWW",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "ngserver",
            "url": "http://localhost:4200/",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
              "webpack:/*": "${webRoot}/*",
              "/./*": "${webRoot}/*",
              "/src/*": "${webRoot}/*",
              "/*": "*",
              "/./~/*": "${webRoot}/node_modules/*"
            }
        }
    ]
  }